# Used by docker-compose.yml directly (Postgres credentials + build-time URLs).
# The backend container ALSO reads backend/.env for everything else
# (SECRET_KEY, Razorpay, SMS, email, etc.) — copy backend/.env.example there too.

DB_NAME=zkart
DB_USER=zkart
DB_PASSWORD=change-me-to-a-real-password

# Public URLs the browser will call — set these to your real domain/subdomains
# once you're past localhost testing, e.g. https://api.zkart.shop/api/v1
CUSTOMER_API_BASE_URL=http://localhost:8000/api/v1
ADMIN_API_BASE_URL=http://localhost:8000/api/v1
VENDOR_API_BASE_URL=http://localhost:8000/api/v1
DELIVERY_API_BASE_URL=http://localhost:8000/api/v1

GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
